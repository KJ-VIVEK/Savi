{
  "name": "savi",
  "displayName": "Savi",
  "description": "Personal assistant for your calendar and tasks",
  "version": "0.5.0",
  "publisher": "KJ-VIVEK",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/KJ-VIVEK/Savi.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "type": "module",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "savi",
          "title": "Savi",
          "icon": "media/savi.svg"
        }
      ]
    },
    "views": {
      "savi": [
        {
          "id": "savi.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "savi.connectGoogle",
        "title": "Connect Google",
        "category": "Savi"
      },
      {
        "command": "savi.disconnectGoogle",
        "title": "Disconnect Google",
        "category": "Savi"
      },
      {
        "command": "savi.setApiKey",
        "title": "Set Model API Key",
        "category": "Savi"
      },
      {
        "command": "savi.clearApiKey",
        "title": "Remove Model API Key",
        "category": "Savi"
      },
      {
        "command": "savi.openGuide",
        "title": "Open Google Setup Guide",
        "category": "Savi"
      },
      {
        "command": "savi.addEvent",
        "title": "Add Event, Reminder or Birthday",
        "category": "Savi",
        "icon": "$(add)"
      },
      {
        "command": "savi.addTask",
        "title": "Add Task",
        "category": "Savi",
        "icon": "$(checklist)"
      },
      {
        "command": "savi.newChat",
        "title": "New Chat",
        "category": "Savi",
        "icon": "$(clear-all)"
      },
      {
        "command": "savi.history",
        "title": "History",
        "category": "Savi",
        "icon": "$(history)"
      },
      {
        "command": "savi.pairPhone",
        "title": "Pair Phone",
        "category": "Savi"
      },
      {
        "command": "savi.phoneDevices",
        "title": "Paired Devices",
        "category": "Savi"
      },
      {
        "command": "savi.phoneOff",
        "title": "Turn Off Phone Access",
        "category": "Savi"
      },
      {
        "command": "savi.openChat",
        "title": "Open Chat in Editor",
        "category": "Savi",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "savi.newChat",
          "when": "view == savi.chat",
          "group": "navigation"
        },
        {
          "command": "savi.history",
          "when": "view == savi.chat",
          "group": "navigation"
        },
        {
          "command": "savi.openChat",
          "when": "view == savi.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Savi",
      "properties": {
        "savi.llm.provider": {
          "type": "string",
          "enum": [
            "claude-code",
            "anthropic"
          ],
          "default": "claude-code",
          "scope": "application",
          "description": "What runs chat.",
          "enumDescriptions": [
            "Your installed Claude Code and its sign-in. No API key.",
            "Claude API with an API key, billed separately."
          ]
        },
        "savi.llm.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Model to use. Empty uses Haiku. With Claude Code you can enter sonnet or opus; with the API, a full model ID such as claude-sonnet-5-5."
        },
        "savi.confirm": {
          "type": "string",
          "enum": [
            "all",
            "modify"
          ],
          "default": "modify",
          "scope": "application",
          "enumDescriptions": [
            "Confirm creating, changing and deleting.",
            "Confirm changing and deleting; create without asking."
          ],
          "description": "Which assistant actions need confirmation."
        },
        "savi.claudeCode.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Claude Code executable. Empty uses the one in the Claude Code extension."
        },
        "savi.phone.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Serve the phone app on the private network. Use the Pair Phone command to turn it on."
        },
        "savi.phone.interface": {
          "type": "string",
          "default": "wt0",
          "scope": "machine",
          "description": "Private network interface the phone connects through. wt0 is NetBird."
        },
        "savi.stayAwake": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "While Savi runs and the PC is plugged in, hold off automatic sleep. Sleeping by hand and closing the lid still work. Needs KDE."
        },
        "savi.webSearch": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Let chat search the web (Claude Code provider only)."
        },
        "savi.llm.expertModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Stronger model for hard questions. Empty uses the latest Sonnet."
        },
        "savi.code.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Full paths of folders Savi may connect to for coding."
        },
        "savi.code.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Model for coding. Empty uses the latest Sonnet."
        },
        "savi.code.internet": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Hosts that commands in a connected project may reach, such as registry.npmjs.org. Empty means no internet."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies --out savi.vsix"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "@anthropic-ai/sdk": "1.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
